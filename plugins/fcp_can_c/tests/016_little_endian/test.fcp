version: "3"

struct U8L {
    val @0: u8,
}

struct U16L {
    val @0: u16,
}

struct U32L {
    val @0: u32,
}

struct U64L {
    val @0: u64,
}

struct I8L {
    val @0: i8,
}

struct I16L {
    val @0: i16,
}

struct I32L {
    val @0: i32,
}

struct I64L {
    val @0: i64,
}

struct F32L {
    val @0: f32,
}

struct F64L {
    val @0: f64,
}

device ecu {
    protocol can {
        impl U8L { id: 10, },
        impl U16L { id: 11, },
        impl U32L { id: 12, },
        impl U64L { id: 13, },
        impl I8L { id: 14, },
        impl I16L { id: 15, },
        impl I32L { id: 16, },
        impl I64L { id: 17, },
        impl F32L { id: 18, },
        impl F64L { id: 19, },
    },
    protocol can2b {
        impl U8L { id: 0x0A7FFF, },
        impl U16L { id: 0x0B2CD0, },
        impl U32L { id: 0x0D3AF2, },
        impl U64L { id: 0x0C231A, },
        impl I8L { id: 0x0F32CD, },
        impl I16L { id: 0x0324CD, },
        impl I32L { id: 0x792DF, },
        impl I64L { id: 0x0934CD, },
        impl F32L { id: 0xEDE34, },
        impl F64L { id: 0x534EF, },
    },
}
