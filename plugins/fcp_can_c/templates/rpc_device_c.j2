{# Recursive macro to generate decode/encode macros #}
{% macro generate_decode_encode_macros(content) %}
{% for message in content %}
{% for signal in message.signals %}
#define can_decode_signal_{{ message.struct_snake }}_{{ signal.name }}(rpc) \
    can_decode_signal_as_{{ signal.scalar_type }}((rpc), {{ signal.start_bit + 16 }}, {{ signal.bit_length }}, {{ signal.scale }}, {{ signal.offset }}, {{ signal.is_big_endian_s }})

#define can_encode_signal_{{ message.struct_snake }}_{{ signal.name }}(signal) \
    can_encode_signal_from_{{ signal.scalar_type }}((signal), {{ signal.start_bit + 16 }}, {{ signal.bit_length }}, {{ signal.scale }}, {{ signal.offset }}, {{ signal.is_big_endian_s }})

{% endfor %}
{% endfor %}
{% endmacro -%}

{%- macro generate_encode_rpc(name, content, blocks) %}
{% for message in content %}
{% for rpc_block in blocks %}
{% if message.is_can_2b == rpc_block.rpc_can_mode %}
{% if message.senders %}
CanFrame can_encode_rpc_{{ message.name_snake }}(const CanRpc{{ message.name_struct }} *rpc{% if message.is_multiplexer %}, uint32_t {{ message.multiplexer_signal }}{% endif %}) {
    {% if message.is_can_2b %}
    CanFrame frame = {
        .ide = 1,
        .sid = {{ name | upper }}_{{ rpc_block.protocol | upper }}_RPC_GET_ID & 0x07FF,
        .eid = ({{ name | upper }}_{{ rpc_block.protocol | upper }}_RPC_GET_ID >> 11) & 0x03FFFF,
        .dlc = {{ message.dlc + 2 }}
    };
    {% else %}
    CanFrame frame = {.eid = 0, .sid = {{ name | upper }}_{{ rpc_block.protocol | upper }}_RPC_GET_ID, .dlc = {{ message.dlc + 2 }}};
    {% endif %}
    uint64_t word = 0, *ptr = (uint64_t *)&frame.data;

    {% for signal in message.signals %}{% if signal.multiplexer_count > 1 %}
    word |= can_encode_signal_{{ message.name_snake }}_{{ signal.name }}(rpc->{{ signal.name }}[{{ message.multiplexer_signal }}]);
    {% else %}
    word |= can_encode_signal_{{ message.name_snake }}_{{ signal.name }}(rpc->{{ signal.name }});
    {% endif %}{% endfor %}

    *ptr = word;
    return frame;
}
{% endif %}
{% endif %}
{% endfor %}
{% endfor %}
{% endmacro -%}

{%- macro generate_encode_rpc_ans(name, content, blocks) %}
{% for message in content %}
{% for rpc_block in blocks %}
{% if message.is_can_2b == rpc_block.rpc_can_mode %}
{% if not message.senders %}
CanFrame can_encode_rpc_{{ message.name_snake }}_ans(const CanRpc{{ message.name_struct }} *rpc) {
    {% if message.is_can_2b %}
    CanFrame frame = {
        .ide = 1,
        .sid = {{ name | upper }}_{{ rpc_block.protocol | upper }}_RPC_ANS_ID & 0x07FF,
        .eid = ({{ name | upper }}_{{ rpc_block.protocol | upper }}_RPC_ANS_ID >> 11) & 0x03FFFF,
        .dlc = {{ message.dlc + 2 }}
    };
    {% else %}
    CanFrame frame = {.sid = {{ name | upper }}_{{ rpc_block.protocol | upper }}_RPC_ANS_ID, .dlc = {{ message.dlc + 2 }}};
    {% endif %}
    uint64_t word = 0, *ptr = (uint64_t *)&frame.data;

    {% for signal in message.signals %}{% if signal.multiplexer_count > 1 %}
    word |= can_encode_signal_{{ message.name_snake }}_{{ signal.name }}(rpc->{{ signal.name }}[rpc->{{ message.multiplexer_signal }}]);
    {% else %}
    word |= can_encode_signal_{{ message.name_snake }}_{{ signal.name }}(rpc->{{ signal.name }});
    {% endif %}{% endfor %}

    *ptr = word;
    return frame;
}
{% endif %}
{% endif %}
{% endfor %}
{% endfor %}
{% endmacro -%}

{%- macro generate_decode_rpc(name, content) %}
{% for message in content %}
{% if not message.senders %}
CanRpc{{ message.name_struct }} can_decode_rpc_{{ message.name_snake }}(const CanFrame *rpc) {
    CanRpc{{ message.name_struct }} r = {0};

    {% for signal in message.signals %}{% if signal.multiplexer_count <= 1 %}
    r.{{ signal.name }} = can_decode_signal_{{ message.name_snake }}_{{ signal.name }}(rpc);
    {% else %}
    r.{{ signal.name }}[r.{{ message.multiplexer_signal }}] = can_decode_signal_{{ message.name_snake }}_{{ signal.name }}(rpc);
    {% endif %}{% endfor %}

    return r;
}
{% endif %}
{% endfor %}
{% endmacro -%}

#include "{{ device_name_snake }}_rpc.h"
#include "{{ device_name_snake }}_can.h"
#include "can_signal_parser.h"

#include <string.h>

/*---------------------------------------- RPC Table and Registry -----------------------------------*/
typedef struct {
    CanRpcId id;
    {{ device_name_pascal }}RpcHandler handler;
} {{ device_name_pascal }}RpcEntry;

static {{ device_name_pascal }}RpcEntry rpc_table[MAX_RPC_ENTRIES];
static size_t rpc_table_size = 0;

/*---------------------------------------- RPC Validation ------------------------------------------*/
bool is_{{ device_name_snake }}_rpc(const CanFrame *frame) {
    uint32_t id;

    if(!frame) return false;
    
    if(frame->ide == 1) {
        id = frame->sid & (frame->eid << 11); 
    } else {
        id = frame->sid;
    }

    return (
    {%- for rpc_block in rpc_blocks +%}
    {% if rpc_block.rpc_ans_id is not none or rpc_block.rpc_get_id is not none %}
        id == {{ device_name_snake | upper }}_{{ rpc_block.protocol | upper }}_RPC_GET_ID || id == {{ device_name_snake | upper }}_{{ rpc_block.protocol | upper }}_RPC_ANS_ID{% if not loop.last %} || {% else %});{% endif %}
    {% endif %}
    {% endfor %}

}

/*---------------------------------------- Decode / Encode Signals ---------------------------------*/
{{ generate_decode_encode_macros(rpc_structs) -}}
/*---------------------------------------- Decode / Encode RPC Structs -------------------------------*/
{{ generate_decode_rpc(device_name_snake, rpcs) }}
{{ generate_encode_rpc(device_name_snake, rpcs, rpc_blocks) }}
{{ generate_encode_rpc_ans(device_name_snake, rpcs, rpc_blocks) }}
/*---------------------------------------- RPC Registration API ------------------------------------*/
bool {{ device_name_snake }}_rpc_register(uint8_t service, uint8_t method, {{ device_name_pascal }}RpcHandler handler) {
    if (!handler || rpc_table_size >= MAX_RPC_ENTRIES) return false;

    for (size_t i = 0; i < rpc_table_size; i++) {
        if (rpc_table[i].id.service == service && rpc_table[i].id.method == method) {
            rpc_table[i].handler = handler;
            return true;
        }
    }

    rpc_table[rpc_table_size++] = ({{ device_name_pascal }}RpcEntry){.id = {.service = service, .method = method}, .handler = handler};
    return true;
}

bool {{ device_name_snake }}_rpc_unregister(uint8_t service, uint8_t method) {
    for (uint16_t i = 0; i < rpc_table_size; i++) {
        if (rpc_table[i].id.service == service && rpc_table[i].id.method == method) {
            if (rpc_table_size > 1 && i < rpc_table_size - 1)
                rpc_table[i] = rpc_table[rpc_table_size - 1];
            rpc_table_size--;
            return true;
        }
    }

    return false;
}


/*---------------------------------------- RPC Lookup ----------------------------------------------*/
static {{ device_name_pascal }}RpcHandler find_rpc_handler(uint16_t rpc_id) {

    for (size_t i = 0; i < rpc_table_size; i++)
        if (rpc_table[i].id.rpc_id == rpc_id) return rpc_table[i].handler;
    
    return NULL;
}

/*---------------------------------------- RPC Dispatch ---------------------------------------------*/
void {{ device_name_snake }}_service_dispatch(
    const CanFrame *frame,
    void (*send_func)(const CanFrame *)
) {
    if (!frame || !is_{{ device_name_snake }}_rpc(frame) || frame->dlc < 2)
        return;

    CanRpcId id = { .service = frame->data[0], .method = frame->data[1] };
    {{ device_name_pascal }}RpcHandler handler = find_rpc_handler(id.rpc_id);
    if (!handler)
        return;

    CanFrame response = {0};
    handler(frame, &response);

    if (send_func)
        send_func(&response);
}

