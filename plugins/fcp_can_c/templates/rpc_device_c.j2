{# Recursive macro to generate decode/encode macros #}
{% macro generate_decode_encode_macros(content) %}
{% for message in content %}
{% for signal in message.signals %}
#define can_decode_signal_{{ message.struct_snake }}_{{ signal.name }}(rpc) \
    can_decode_signal_as_{{ signal.scalar_type }}((rpc), {{ signal.start_bit + 16 }}, {{ signal.bit_length }}, {{ signal.scale }}, {{ signal.offset }}, {{ signal.is_big_endian_s }})

#define can_encode_signal_{{ message.struct_snake }}_{{ signal.name }}(signal) \
    can_encode_signal_from_{{ signal.scalar_type }}((signal), {{ signal.start_bit + 16 }}, {{ signal.bit_length }}, {{ signal.scale }}, {{ signal.offset }}, {{ signal.is_big_endian_s }})

{% endfor %}
{% endfor %}
{% endmacro -%}

{%- macro generate_encode_rpc(name, content) %}
{% for message in content %}
{% if message.senders and message.signals %}
{{ protocol | upper }}Frame {{ protocol }}_encode_rpc_{{ message.name_snake }}(const {{ protocol | upper }}Rpc{{ message.name_struct }} *rpc{% if message.is_multiplexer %}, uint32_t {{ message.multiplexer_signal }}{% endif %}) {
    {% if message.is_can_2b %}
    CAN2BFrame frame = {
        .ide = 1,
        .sid = {{ name | upper }}_{{ protocol | upper }}_RPC_GET_ID & 0x07FF,
        .eid = ({{ name | upper }}_{{ protocol | upper }}_RPC_GET_ID >> 11) & 0x03FFFF,
        .dlc = {{ message.dlc}}
    };
    {% else %}
    CANFrame frame = {.eid = 0, .sid = {{ name | upper }}_{{ protocol | upper }}_RPC_GET_ID, .dlc = {{ message.dlc}}};
    {% endif %}
    uint64_t word = 0, *ptr = (uint64_t *)&frame.data;

    word |= can_encode_signal_service_id({{ message.service_id }});
    word |= can_encode_signal_method_id({{ message.method_id }});
    {% for signal in message.signals %}{% if signal.multiplexer_count > 1 %}
    word |= can_encode_signal_{{ message.struct_snake }}_{{ signal.name }}(rpc->{{ signal.name }}[{{ message.multiplexer_signal }}]);
    {% else %}
    word |= can_encode_signal_{{ message.struct_snake }}_{{ signal.name }}(rpc->{{ signal.name }});
    {% endif %}{% endfor %}

    *ptr = word;
    return frame;
}
{% elif message.senders and not message.signals %}
{{ protocol | upper }}Frame {{ protocol }}_encode_rpc_{{ message.name_snake }}(void) {
    {% if message.is_can_2b %}
    CAN2BFrame frame = {
        .ide = 1,
        .sid = {{ name | upper }}_{{ protocol | upper }}_RPC_GET_ID & 0x07FF,
        .eid = ({{ name | upper }}_{{ protocol | upper }}_RPC_GET_ID >> 11) & 0x03FFFF,
        .dlc = {{ message.dlc}}
    };
    {% else %}
    CANFrame frame = {.eid = 0, .sid = {{ name | upper }}_{{ protocol | upper }}_RPC_GET_ID, .dlc = {{ message.dlc}}};
    {% endif %}
    uint64_t word = 0, *ptr = (uint64_t *)&frame.data;

    word |= can_encode_signal_service_id({{ message.service_id }});
    word |= can_encode_signal_method_id({{ message.method_id }});

    *ptr = word;
    return frame;
}
{% endif %}
{% endfor %}
{% endmacro -%}

{%- macro generate_encode_rpc_ans(name, content) %}
{% for message in content %}
{% if not message.senders %}
{{ protocol | upper }}Frame {{ protocol }}_encode_rpc_{{ message.name_snake }}_ans(const {{ protocol | upper }}Rpc{{ message.name_struct }} *rpc) {
    {% if message.is_can_2b %}
    CAN2BFrame frame = {
        .ide = 1,
        .sid = {{ name | upper }}_{{ protocol | upper }}_RPC_ANS_ID & 0x07FF,
        .eid = ({{ name | upper }}_{{ protocol | upper }}_RPC_ANS_ID >> 11) & 0x03FFFF,
        .dlc = {{ message.dlc }}
    };
    {% else %}
    CANFrame frame = {.sid = {{ name | upper }}_{{ protocol | upper }}_RPC_ANS_ID, .dlc = {{ message.dlc}}};
    {% endif %}
    uint64_t word = 0, *ptr = (uint64_t *)&frame.data;

    word |= can_encode_signal_service_id({{ message.service_id }});
    word |= can_encode_signal_method_id({{ message.method_id }});
    {% for signal in message.signals %}{% if signal.multiplexer_count > 1 %}
    word |= can_encode_signal_{{ message.struct_snake }}_{{ signal.name }}(rpc->{{ signal.name }}[rpc->{{ message.multiplexer_signal }}]);
    {% else %}
    word |= can_encode_signal_{{ message.struct_snake }}_{{ signal.name }}(rpc->{{ signal.name }});
    {% endif %}{% endfor %}

    *ptr = word;
    return frame;
}
{% endif %}
{% endfor %}
{% endmacro -%}

{%- macro generate_decode_rpc(name, content) %}
{% for message in content %}
{% if message.senders and message.signals %}
{{ protocol | upper }}Rpc{{ message.name_struct }} {{ message.protocol }}_decode_rpc_{{ message.name_snake }}(const {{ protocol | upper }}Frame *rpc) {
    {% if can_mode %}
    CAN2BRpc{{ message.name_struct }} r = {0};
    {% else %}
    CANRpc{{ message.name_struct }} r = {0};
    {% endif %}

    {% for signal in message.signals %}{% if signal.multiplexer_count <= 1 %}
    r.{{ signal.name }} = can_decode_signal_{{ message.struct_snake }}_{{ signal.name }}(rpc);
    {% else %}
    r.{{ signal.name }}[r.{{ message.multiplexer_signal }}] = can_decode_signal_{{ message.struct_snake }}_{{ signal.name }}(rpc);
    {% endif %}{% endfor %}

    return r;
}
{% endif %}
{% endfor %}
{% endmacro -%}

{%- macro generate_decode_rpc_ans(name, content) %}
{% for message in content %}
{% if not message.senders %}
{{ protocol | upper }}Rpc{{ message.name_struct }} {{ message.protocol }}_decode_rpc_{{ message.name_snake }}_ans(const {{ protocol | upper }}Frame *rpc) {
    {% if can_mode %}
    CAN2BRpc{{ message.name_struct }} r = {0};
    {% else %}
    CANRpc{{ message.name_struct }} r = {0};
    {% endif %}

    {% for signal in message.signals %}{% if signal.multiplexer_count <= 1 %}
    r.{{ signal.name }} = can_decode_signal_{{ message.struct_snake }}_{{ signal.name }}(rpc);
    {% else %}
    r.{{ signal.name }}[r.{{ message.multiplexer_signal }}] = can_decode_signal_{{ message.struct_snake }}_{{ signal.name }}(rpc);
    {% endif %}{% endfor %}

    return r;
}
{% endif %}
{% endfor %}
{% endmacro -%}

#include "{{ device_name_snake }}_{{ protocol }}_rpc.h"
#include "{{ device_name_snake }}_{{ protocol }}.h"
#include "can_signal_parser.h"

#include <string.h>

/*---------------------------------------- RPC Table and Registry -----------------------------------*/
typedef struct {
    {{ protocol | upper }}RpcId id;
    {{ device_name_pascal }}{{ protocol | upper }}RpcHandler handler;
} {{ device_name_pascal }}{{ protocol | upper }}RpcEntry;

static {{ device_name_pascal }}{{ protocol | upper }}RpcEntry rpc_{{ protocol }}_table[MAX_{{ device_name_snake | upper }}_{{ protocol | upper }}_RPC_ENTRIES];
static size_t rpc_{{ protocol }}_table_size = 0;

/*---------------------------------------- RPC Validation ------------------------------------------*/
bool is_{{ device_name_snake }}_{{ protocol }}_rpc(const {{ protocol | upper }}Frame *frame) {
    uint32_t id;

    if(!frame) return false;

    {% if can_mode %}
    id = frame->sid | (frame->eid << 11); 
    {% else %}
    id = frame->sid;
    {% endif %}

    return (id == {{ device_name_snake | upper }}_{{ protocol | upper }}_RPC_GET_ID || id == {{ device_name_snake | upper }}_{{ protocol | upper }}_RPC_ANS_ID);

}

/*---------------------------------------- Decode / Encode Signals ---------------------------------*/
#define can_decode_signal_service_id(rpc) \
    can_decode_signal_as_uint8_t((rpc), 0, 8, 1.0, 0.0, false)

#define can_encode_signal_service_id(signal) \
    can_encode_signal_from_uint8_t((signal), 0, 8, 1.0, 0.0, false)

#define can_decode_signal_method_id(rpc) \
    can_decode_signal_as_uint8_t((rpc), 0, 8, 1.0, 0.0, false)

#define can_encode_signal_method_id(signal) \
    can_encode_signal_from_uint8_t((signal), 0, 8, 1.0, 0.0, false)

{{ generate_decode_encode_macros(rpc_structs) -}}
/*---------------------------------------- Decode / Encode RPC Structs -------------------------------*/
{{ generate_decode_rpc(device_name_snake, rpcs) }}
{{ generate_decode_rpc_ans(device_name_snake, rpcs) }}
{{ generate_encode_rpc(device_name_snake, rpcs) }}
{{ generate_encode_rpc_ans(device_name_snake, rpcs) }}
/*---------------------------------------- RPC Registration API ------------------------------------*/
bool {{ device_name_snake }}_{{ protocol }}_rpc_register(uint8_t service, uint8_t method, {{ device_name_pascal }}{{ protocol | upper }}RpcHandler handler) {
    if (!handler || rpc_{{ protocol }}_table_size >= MAX_{{ device_name_snake | upper }}_{{ protocol | upper }}_RPC_ENTRIES) return false;

    for (size_t i = 0; i < rpc_{{ protocol }}_table_size; i++) {
        if (rpc_{{ protocol }}_table[i].id.service == service && rpc_{{ protocol }}_table[i].id.method == method) {
            rpc_{{ protocol }}_table[i].handler = handler;
            return true;
        }
    }

    rpc_{{ protocol }}_table[rpc_{{ protocol }}_table_size++] = ({{ device_name_pascal }}{{ protocol | upper }}RpcEntry){.id = {.service = service, .method = method}, .handler = handler};
    return true;
}

bool {{ device_name_snake }}_{{ protocol }}_rpc_unregister(uint8_t service, uint8_t method) {
    for (uint16_t i = 0; i < rpc_{{ protocol }}_table_size; i++) {
        if (rpc_{{ protocol }}_table[i].id.service == service && rpc_{{ protocol }}_table[i].id.method == method) {
            if (rpc_{{ protocol }}_table_size > 1 && i < rpc_{{ protocol }}_table_size - 1)
                rpc_{{ protocol }}_table[i] = rpc_{{ protocol }}_table[rpc_{{ protocol }}_table_size - 1];
            rpc_{{ protocol }}_table_size--;
            return true;
        }
    }

    return false;
}


/*---------------------------------------- RPC Lookup ----------------------------------------------*/
static {{ device_name_pascal }}{{ protocol | upper }}RpcHandler find_rpc_handler(uint16_t rpc_id) {

    for (size_t i = 0; i < rpc_{{ protocol }}_table_size; i++)
        if (rpc_{{ protocol }}_table[i].id.rpc_id == rpc_id) return rpc_{{ protocol }}_table[i].handler;
    
    return NULL;
}

/*---------------------------------------- RPC Dispatch ---------------------------------------------*/
void {{ device_name_snake }}_{{ protocol }}_service_dispatch(
    const {{ protocol | upper }}Frame *frame,
    void (*send_func)(const {{ protocol | upper }}Frame *)
) {
    if (!frame || !is_{{ device_name_snake }}_{{ protocol }}_rpc(frame) || frame->dlc < 2)
        return;

{{ '    ' }}{{ protocol | upper }}RpcId id = { .service = frame->data[0], .method = frame->data[1] };
    {{ device_name_pascal }}{{ protocol | upper }}RpcHandler handler = find_rpc_handler(id.rpc_id);
    if (!handler)
        return;

{{ '    ' }}{{ protocol | upper }}Frame response = {0};
    handler(frame, &response);

    if (send_func)
        send_func(&response);
}

