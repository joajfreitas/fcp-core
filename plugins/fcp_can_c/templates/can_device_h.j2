#ifndef {{ device_name_snake | upper }}_{{ protocol | upper }}_H
#define {{ device_name_snake | upper }}_{{ protocol | upper }}_H

#include <stdint.h>
#include <stdbool.h>

#include "can_frame.h"
#include "can_structs.h"
{% if include_global %}
#include "global_{{ protocol }}.h"
{% endif %}

{% if messages | length > 0 %}
/* {{ device_name_pascal }} Message IDs */
{% for message in messages %}
#define {{ message.protocol | upper }}_MSG_ID_{{ message.name_snake | upper }} {{ message.frame_id }}
{% endfor %}

/* {{ device_name_pascal }} Message Periods */
{% for message in messages %}
#define {{ message.protocol | upper }}_MSG_PERIOD_{{ message.name_snake | upper }} {{ message.period }}
{% endfor %}
{% endif -%}

/* Check if a CanFrame comes from {{ device_name_pascal }} */
bool {{ protocol }}_is_{{ device_name_snake }}_msg(const {{ protocol | upper }}Frame *frame);

{% if not is_global_device %}
/* Send {{ device_name_pascal }} messages according to their defined period */
void {{ protocol }}_send_{{ device_name_snake }}_msgs_scheduled(
    const {{ protocol | upper }}Device{{ device_name_pascal }} *dev,
    uint32_t time,
    void (*send_can_func)(const {{ protocol | upper }}Frame *)
);
{% endif %}

/* Functions to decode CanFrame into CanMsg<name> objects */
{% for message in messages %}
{{ protocol | upper }}Msg{{ message.name_pascal }} {{ message.protocol }}_decode_msg_{{ message.name_snake }}(const {{ protocol | upper }}Frame *frame);
{% endfor %}

/* Functions to encode CanMsg<name> object into CanFrame */
{% for message in messages %}
{% if message.is_multiplexer %}
{{ protocol | upper }}Frame {{ message.protocol }}_encode_msg_{{ message.name_snake }}(const {{ protocol | upper }}Msg{{ message.name_pascal }} *msg, uint32_t {{ message.multiplexer_signal }});
{% else %}
{{ protocol | upper }}Frame {{ message.protocol }}_encode_msg_{{ message.name_snake }}(const {{ protocol | upper }}Msg{{ message.name_pascal }} *msg);
{% endif %}
{% endfor %}

#endif // {{ device_name_snake | upper }}_{{ protocol | upper }}_H
