{% macro generate_rpc_decode(content) %}
{% for message in content %}
{% if message.senders %}
{% if can_mode %}Can2B{% else %}Can{% endif %}Rpc{{ message.name_struct }} {{ message.protocol }}_decode_rpc_{{ message.name_snake }}(const {% if can_mode %}Can2B{% else %}Can{% endif %}Frame *rpc);
{% endif %}
{% endfor %}
{% endmacro -%}

{%- macro generate_rpc_decode_ans(content) %}
{% for message in content %}
{% if not message.senders %}
{% if can_mode %}Can2B{% else %}Can{% endif %}Rpc{{ message.name_struct }} {{ message.protocol }}_decode_rpc_{{ message.name_snake }}_ans(const {% if can_mode %}Can2B{% else %}Can{% endif %}Frame *rpc);
{% endif %}
{% endfor %}
{% endmacro -%}

{%- macro generate_rpc_encode(content) %}
{% for message in content %}
{% if message.senders %}
{% if can_mode %}Can2B{% else %}Can{% endif %}Frame {{ message.protocol }}_encode_rpc_{{ message.name_snake }}(const {% if can_mode %}Can2B{% else %}Can{% endif %}Rpc{{ message.name_struct }} *rpc{% if message.is_multiplexer %}, uint32_t {{ message.multiplexer_signal }}{% endif %});
{% endif %}
{% endfor %}
{% endmacro -%}

{%- macro generate_rpc_encode_ans(content) %}
{% for message in content %}
{% if not message.senders %}
{% if can_mode %}Can2B{% else %}Can{% endif %}Frame {{ message.protocol }}_encode_rpc_{{ message.name_snake }}_ans(const {% if can_mode %}Can2B{% else %}Can{% endif %}Rpc{{ message.name_struct }} *rpc);
{% endif %}
{% endfor %}
{% endmacro -%}

#ifndef {{ device_name_snake | upper }}_{{ protocol | upper}}_RPC_H
#define {{ device_name_snake | upper }}_{{ protocol | upper}}_RPC_H

#include <stdint.h>
#include <stdbool.h>
#include "can_frame.h"

/*---------------------------------------- Type Definitions ----------------------------------------*/
#define {{ device_name_snake | upper }}_{{ protocol | upper }}_RPC_GET_ID {{ rpc_get_id }}
#define {{ device_name_snake | upper }}_{{ protocol | upper }}_RPC_ANS_ID {{ rpc_ans_id }}
#define MAX_RPC_ENTRIES {{ messages|length }}

typedef union {
    struct {
        uint8_t service;
        uint8_t method;
    };
    uint16_t rpc_id;
} {% if can_mode %}Can2B{% else %}Can{% endif %}RpcId;


/**
 * @brief RPC handler function prototype.
 * 
 * Each handler should process an incoming frame and fill out the response.
 * 
 * @param request  Pointer to the incoming CAN frame.
 * @param response Pointer to the CAN frame that will be filled as the response.
 */
typedef void (*{{ device_name_pascal }}{% if can_mode %}Can2B{% else %}Can{% endif %}RpcHandler)(const {% if can_mode %}Can2B{% else %}Can{% endif %}Frame *request, {% if can_mode %}Can2B{% else %}Can{% endif %}Frame *response);

/*---------------------------------------- RPC Utility Functions -----------------------------------*/

/**
 * @brief Check if a CAN frame belongs to this device's RPC namespace.
 */
bool is_{{ device_name_snake }}_{{ protocol }}_rpc(const {% if can_mode %}Can2B{% else %}Can{% endif %}Frame *frame);

/**
 * @brief Main RPC dispatcher.
 * 
 * Finds and invokes the handler corresponding to a service + method ID.
 * Automatically sends back a response using the provided callback.
 */
void {{ device_name_snake }}_{{ protocol }}_service_dispatch(
    const {% if can_mode %}Can2B{% else %}Can{% endif %}Frame *frame,
    void (*send_func)(const {% if can_mode %}Can2B{% else %}Can{% endif %}Frame *)
);

/*---------------------------------------- RPC Registration API ------------------------------------*/

/**
 * @brief Register an RPC handler dynamically.
 * 
 * Adds or updates a handler in the internal RPC table.
 * 
 * @param service RPC service identifier.
 * @param method  RPC method identifier.
 * @param handler    Function pointer to the handler.
 * @return true if successfully registered or updated, false otherwise.
 */
bool {{ device_name_snake }}_{{ protocol }}_rpc_register(uint8_t service, uint8_t method, {{ device_name_pascal }}{% if can_mode %}Can2B{% else %}Can{% endif %}RpcHandler handler);

/**
 * @brief Unregister an RPC handler dynamically.
 * 
 * Removes the handler associated with the given service and method IDs.
 * 
 * @param service RPC service identifier.
 * @param method  RPC method identifier.
 * @return true if successfully unregistered, false if not found.
 */
bool {{ device_name_snake }}_{{ protocol }}_rpc_unregister(uint8_t service, uint8_t method);

/**
 * @brief Initialize and pre-register all statically generated RPC handlers.
 * 
 * Should be called once during system startup.
 */
void {{ device_name_snake }}_{{ protocol }}_rpc_init(void);

/*---------------------------------------- RPC Encode/Decode Structs --------------------------------*/
{%- for message in rpc_structs +%}
typedef struct {
    {% for signal in message.signals %}
    {% if signal.multiplexer_count > 1 %}
    {{ signal.scalar_type }} {{ signal.name }}[{{ signal.multiplexer_count }}];
    {% else %}
    {{ signal.scalar_type }} {{ signal.name }};
    {% endif %}
    {% endfor %}
} {% if can_mode %}Can2B{% else %}Can{% endif %}Rpc{{ message.name_struct }};
{% endfor %}
/*---------------------------------------- RPC Encode/Decode Rpcs -----------------------------------*/
{{ generate_rpc_decode(messages) }}
{{ generate_rpc_decode_ans(messages) }}
{{ generate_rpc_encode(messages) }}
{{ generate_rpc_encode_ans(messages) -}}
/*---------------------------------------- Generated Service Handlers -------------------------------*/
{% for service in services %}
{% for method in service.methods %}
/**
 * @brief Handler for {{ service.name }}.{{ method.name }} RPC method.
 */
void {{ device_name_snake }}_{{ protocol }}_service_handle_{{ method.name_snake }}(const {% if can_mode %}Can2B{% else %}Can{% endif %}Frame *request, {% if can_mode %}Can2B{% else %}Can{% endif %}Frame *response);
{% endfor %}
{% endfor %}

#endif /* {{ device_name_upper }}_RPC_H */
